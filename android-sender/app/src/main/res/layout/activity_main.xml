<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HYPERMIRROR PRO"
            android:textColor="@color/accent_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ultra-Low Latency Gaming Mirror (H.264 / H.265)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Live Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRẠNG THÁI: SẴN SÀNG"
                android:textColor="@color/accent_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTelemetryMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="FPS: 0 | Bitrate: 0.0 Mbps\nEncode: 0.0 ms | RTT: 0.0 ms"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Connection Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. CHẾ ĐỘ KẾT NỐI (USB / WI-FI)"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTransportMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbUsbServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Cắm dây USB (ADB Forward - Độ trễ ~10ms)"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbWifiClient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi 5GHz / USB Reverse (Kết nối tới IP PC)"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <EditText
                android:id="@+id/etTargetIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="IP Máy tính (VD: 192.168.1.10 hoặc 127.0.0.1)"
                android:inputType="textUri"
                android:text="192.168.1.10"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </LinearLayout>

        <!-- Codec & FPS & Resolution -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. TỐI ƯU FPS, CODEC &amp; BITRATE CHƠI GAME"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Codec Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chuẩn nén phần cứng (Hardware Codec):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgCodec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbH264"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="H.264 (AVC)"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbH265"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="H.265 (HEVC)"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- FPS Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tốc độ khung hình (Target FPS):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFps60"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="60 FPS"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbFps90"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="90 FPS"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbFps120"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="120 FPS"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- Resolution Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Độ phân giải (Resolution):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbRes720"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="720p"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbRes1080"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="1080p"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbRes1440"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1440p"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbResNative"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gốc"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- Bitrate Slider -->
            <TextView
                android:id="@+id/tvBitrateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Bitrate (Đổi trực tiếp khi đang phát): 16 Mbps"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="40"
                android:progress="16" />
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnToggleMirror"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent_cyan"
            android:text="BẮT ĐẦU CHIẾU MÀN HÌNH (ZERO-LATENCY)"
            android:textColor="@color/bg_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnForceIdr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/bg_card"
            android:text="LÀM TƯƠI KHUNG HÌNH NGAY (FORCE IDR SYNC)"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</ScrollView>
